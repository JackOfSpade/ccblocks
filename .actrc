# Local `act` compatibility only: an add-path command (the Linux job adds
# Homebrew to GITHUB_PATH) can make amd64 containers on Apple Silicon use a
# nonexistent arm64 Node toolcache path for later JavaScript action steps.
--env PATH=/opt/acttoolcache/node/24.19.0/x64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin

# Local act must exercise only the Linux row. `act` may otherwise execute a
# dynamic `macos-latest` matrix row in its default Linux image, falsely passing
# macOS coverage. Do not map macos-latest to -self-hosted: that row performs
# Homebrew mutations. GitHub Actions still receives the unmodified workflow
# matrix and runs both ubuntu-latest and macos-latest.
--matrix os:ubuntu-latest
