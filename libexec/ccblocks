#!/usr/bin/env bash

# ccblocks - Main CLI interface
# Claude Code block scheduler

set -euo pipefail

# Get the directory where ccblocks is installed (resolve symlinks).
# readlink follows one hop and cannot detect a cycle, so bound the walk:
# a symlink loop would otherwise spin here forever.
SOURCE="${BASH_SOURCE[0]}"
hops=0
while [ -L "$SOURCE" ]; do
	hops=$((hops + 1))
	if [ "$hops" -gt 40 ]; then
		echo "Error: too many symlink levels resolving ${BASH_SOURCE[0]} (symlink loop?)" >&2
		exit 1
	fi
	DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
	SOURCE="$(readlink "$SOURCE")"
	[[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Source common library
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"

# Show usage
show_usage() {
	show_logo
	echo ""
	echo "Usage: ccblocks <command> [options]"
	echo ""
	echo "Commands:"
	echo "  setup               # Install ccblocks (pings every ${CCBLOCKS_INTERVAL_MINUTES} minutes)"
	echo "  status              # Show current scheduler and trigger status"
	echo "  trigger             # Manually trigger a new block now"
	echo "  schedule <action>   # Manage scheduling (current/pause/resume/remove)"
	echo "  pause               # Temporarily disable ccblocks"
	echo "  resume              # Re-enable paused schedule"
	echo "  uninstall           # Remove ccblocks completely"
	echo "  help                # Show this help message"
	echo ""
	echo "Schedule actions:"
	echo "  current             # Show current scheduler status"
	echo "  pause               # Pause ccblocks"
	echo "  resume              # Resume after pause"
	echo "  remove              # Remove all ccblocks schedules"
	echo ""
	echo "Examples:"
	echo "  ccblocks setup       # Initial installation"
	echo "  ccblocks status      # Check current status"
	echo "  ccblocks trigger     # Trigger a new block now"
	echo "  ccblocks pause       # Pause for vacation"
	echo "  ccblocks resume      # Resume schedule"
	echo ""
	echo "For more help on specific commands:"
	echo "  ccblocks setup --help"
	echo "  ccblocks status --help"
	echo "  ccblocks schedule --help"
}

# Resolve the version string. Homebrew rewrites the sentinel below at
# install time; building it by concatenation keeps a global sentinel
# substitution from also rewriting the comparisons and defeating the
# development fallbacks.
resolve_version() {
	local sentinel version candidate
	sentinel='__VER''SION__'
	version="__VERSION__"

	if [ "$version" != "$sentinel" ]; then
		printf '%s\n' "$version"
		return 0
	fi

	# Fallback to VERSION file for development/non-Homebrew installations
	for candidate in "$SCRIPT_DIR/VERSION" "$SCRIPT_DIR/../VERSION"; do
		if [ -f "$candidate" ]; then
			version=$(tr -d '\n\r' <"$candidate")
			# An empty or whitespace-only file tells us nothing
			if [ -n "${version//[[:space:]]/}" ]; then
				printf '%s\n' "$version"
				return 0
			fi
		fi
	done

	printf '%s\n' "unknown"
}

# Main command dispatcher
main() {
	case "${1:-help}" in
	"setup")
		shift
		exec "$SCRIPT_DIR/bin/setup.sh" "$@"
		;;
	"status")
		shift
		exec "$SCRIPT_DIR/bin/status.sh" "$@"
		;;
	"trigger")
		shift
		exec "$SCRIPT_DIR/bin/trigger.sh" "$@"
		;;
	"schedule")
		shift
		exec "$SCRIPT_DIR/bin/schedule.sh" "$@"
		;;
	"pause")
		exec "$SCRIPT_DIR/bin/schedule.sh" pause
		;;
	"resume" | "unpause")
		exec "$SCRIPT_DIR/bin/schedule.sh" resume
		;;
	"uninstall")
		shift
		exec "$SCRIPT_DIR/bin/uninstall.sh" "$@"
		;;
	"help" | "-h" | "--help")
		show_usage
		;;
	"--version" | "-v")
		VERSION="$(resolve_version)"
		echo "ccblocks $VERSION"
		;;
	*)
		print_error "Unknown command: $1"
		echo ""
		show_usage
		exit 1
		;;
	esac
}

# Run main function
main "$@"
